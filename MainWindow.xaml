<Window x:Class="EriMixer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EriMixer" Width="420" Height="560" MinWidth="350" MinHeight="280" Background="{DynamicResource ThemeWindowBackground}" Foreground="{DynamicResource ThemeText}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <Style x:Key="DeviceSelectorButtonStyle" TargetType="{x:Type Button}">
  <Setter Property="Background" Value="{DynamicResource ThemeSelectorBackground}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ThemeSelectorBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Button}">
   <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ThemeSelectorHover}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentLight}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="FooterButtonStyle" TargetType="{x:Type Button}">
  <Setter Property="Background" Value="{DynamicResource ThemeButtonBackground}"/>
  <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource ThemeButtonBorder}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template"><Setter.Value>
   <ControlTemplate TargetType="{x:Type Button}">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource ThemeAccentLight}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate>
  </Setter.Value></Setter>
 </Style>
</Window.Resources>
 <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border x:Name="HeaderBar" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DockPanel Margin="0,0,10,0">
    <Image Width="44" Height="44" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="Ery · EriMixer" AutomationProperties.Name="Ery mixer emblem">
     <Image.Source><BitmapImage UriSource="pack://application:,,,/Assets/EryMixerEmblem.png" DecodePixelWidth="176"/></Image.Source>
    </Image>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="EriMixer" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="E R I V Y R A  /  A U D I O" FontSize="9" Foreground="{DynamicResource ThemeAccentLight}" Margin="1,3,0,0"/></StackPanel>
   </DockPanel><Button x:Name="ModeButton" Grid.Column="1" Content="Popup" Click="Popup_Click" VerticalAlignment="Center" ToolTip="Switch between desktop window and tray popup"/></Grid></Border>
  <StackPanel Grid.Row="1" Margin="0,0,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="OutputDeviceButton" Grid.Column="0" Style="{StaticResource DeviceSelectorButtonStyle}" Height="62" Click="OutputDeviceButton_Click" ToolTip="Choose the default Windows playback device" AutomationProperties.Name="Choose default output device">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
      <Path Grid.Column="0" Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="{DynamicResource ThemeAccentLight}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,9 L7,9 L12,4 L12,20 L7,15 L3,15 Z M16,9 C18,11 18,13 16,15 M19,6 C23,10 23,14 19,18"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock Text="OUTPUT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentLight}"/>
       <TextBlock x:Name="OutputDeviceName" Text="Detecting devices…" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeText}"/>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="18" Foreground="{DynamicResource ThemeSecondaryText}"/>
     </Grid>
    </Button>
    <Button x:Name="InputDeviceButton" Grid.Column="2" Style="{StaticResource DeviceSelectorButtonStyle}" Height="62" Click="InputDeviceButton_Click" ToolTip="Choose the default Windows microphone" AutomationProperties.Name="Choose default input device">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
      <Path Grid.Column="0" Width="18" Height="20" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="{DynamicResource ThemeAccentLight}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,2 C10,2 9,4 9,6 L9,12 C9,16 15,16 15,12 L15,6 C15,4 14,2 12,2 Z M6,11 C6,19 18,19 18,11 M12,18 L12,22 M8,22 L16,22"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock Text="INPUT" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource ThemeAccentLight}"/>
       <TextBlock x:Name="InputDeviceName" Text="Detecting devices…" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ThemeText}"/>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="18" Foreground="{DynamicResource ThemeSecondaryText}"/>
     </Grid>
    </Button>
   </Grid>
   <TextBlock x:Name="DeviceSelectionStatus" Visibility="Collapsed" Foreground="{DynamicResource ThemeAccentLight}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="APPLICATION VOLUME" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemeSecondaryText}"/><TextBlock x:Name="DeviceLabel" FontSize="11" Foreground="{DynamicResource ThemeQuietText}" Margin="0,4,8,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="↻" FontSize="18" Padding="9,2" Click="Refresh_Click" ToolTip="Refresh applications" AutomationProperties.Name="Refresh applications"/></Grid>
  <Grid Grid.Row="3"><ScrollViewer x:Name="SessionsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="SessionsPanel"/></ScrollViewer><TextBlock x:Name="EmptyState" Text="Play audio in an app to see it here." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeSecondaryText}" Visibility="Collapsed"/></Grid>
  <StackPanel Grid.Row="4" Margin="0,12,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="FitAppsButton" Style="{StaticResource FooterButtonStyle}" Content="Fit apps ↕" Visibility="Collapsed" Click="FitApps_Click" FontSize="11" Padding="8,4" Margin="0,0,8,0" ToolTip="Expand the popup to fit the application list; drag any edge to resize manually"/><Button x:Name="ShortcutButton" Style="{StaticResource FooterButtonStyle}" Content="Hot Keys" Click="Shortcut_Click" HorizontalAlignment="Left" FontSize="11" Padding="8,4" ToolTip="Configure popup and audio device shortcuts"/><Button x:Name="ThemeButton" Style="{StaticResource FooterButtonStyle}" Content="Theme" Click="Theme_Click" HorizontalAlignment="Left" FontSize="11" Padding="8,4" Margin="8,0,0,0" ToolTip="Choose an EriMixer colour theme"/></StackPanel><TextBlock Text="Esc closes popup · Close hides to tray · Right-click tray icon to exit" Foreground="{DynamicResource ThemeQuietText}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
