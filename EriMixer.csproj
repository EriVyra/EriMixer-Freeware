<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EriMixer</AssemblyName>
    <Version>0.3.0</Version>
    <FileVersion>0.3.0.0</FileVersion>
    <Product>EriMixer</Product>
    <Company>EriVyra</Company>
    <ApplicationIcon>Assets\EriMixer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="NAudio" Version="2.2.1" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\EriMixer.ico" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\EryMixerEmblem.png" /></ItemGroup>
</Project>
